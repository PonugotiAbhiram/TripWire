# TripWire Environment Configuration (Example)
# Rename this file to .env and set your values.

# Admin Dashboard Password (REQUIRED)
# Choose a strong password that is at least 12 characters long.
ADMIN_PASSWORD=CHANGE_ME

# Bind Host for Fake Doors
# 0.0.0.0 will bind the honeypot ports to all interfaces
BIND_HOST=0.0.0.0

# Optional Features
# ALLOW_LOCAL_BAN=1